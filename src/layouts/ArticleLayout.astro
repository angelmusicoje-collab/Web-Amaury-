---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  dek: string;
  section: string;
  sectionLabel: string;
  author: string;
  publishedAt: string;
  sources?: Array<{ label: string; url?: string }>;
  angle?: string;
}
const { title, dek, section, sectionLabel, author, publishedAt, sources = [], angle } = Astro.props;
const date = new Date(publishedAt).toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title={`${title} — Meridiano 104`} description={dek}>
  <article class="article">
    <header class="article-head container container-text">
      <a href={`/seccion/${section}`} class="label">{sectionLabel}</a>
      <h1>{title}</h1>
      <p class="dek">{dek}</p>
      <div class="byline">
        <span class="by">Por <strong>{author}</strong></span>
        <span class="dot">&middot;</span>
        <time datetime={publishedAt}>{date}</time>
      </div>
    </header>

    {angle && (
      <aside class="container container-text angle">
        <h3 class="angle-title">Angulo editorial</h3>
        <p>{angle}</p>
      </aside>
    )}

    <div class="container container-text body">
      <slot />
    </div>

    {sources.length > 0 && (
      <footer class="container container-text sources">
        <h3>Fuentes</h3>
        <ul>
          {sources.map((s) => (
            <li>
              {s.url
                ? <a href={s.url} rel="noopener">{s.label}</a>
                : <span>{s.label}</span>}
            </li>
          ))}
        </ul>
      </footer>
    )}

    <div class="container container-text closer">
      <hr />
      <p class="kicker">Meridiano 104 &middot; 104&deg;O &middot; Colima, Mexico</p>
    </div>
  </article>
</BaseLayout>

<style>
  .article-head { padding-top: 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }
  .article-head h1 {
    font-size: clamp(2rem, 5.5vw, 3.6rem);
    margin: 0.8rem 0 1rem;
    letter-spacing: -0.015em;
  }
  .article-head .dek { margin-bottom: 1.5rem; }
  .byline { font-size: 0.9rem; color: var(--stone); display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
  .byline .dot { color: var(--stone-soft); }
  .byline strong { color: var(--ink); font-weight: 600; }
  .angle {
    margin-top: 2rem;
    padding: 1.4rem 1.5rem;
    border-left: 3px solid var(--lava);
    background: rgba(200,52,27,0.04);
  }
  .angle-title {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lava);
    margin: 0 0 0.4rem;
    font-family: var(--sans);
    font-weight: 600;
  }
  .angle p { margin: 0; font-family: var(--serif); font-style: italic; font-size: 1.1rem; color: var(--ink-soft); line-height: 1.5; }
  .body { padding-top: 2rem; font-size: 1.1rem; line-height: 1.75; }
  .body :global(p) { margin-bottom: 1.4em; }
  .body :global(p:first-of-type::first-letter) {
    font-family: var(--serif);
    font-size: 4em;
    float: left;
    line-height: 0.9;
    padding: 0.2rem 0.6rem 0 0;
    color: var(--lava);
    font-weight: 800;
  }
  .body :global(h2) { margin-top: 2.4em; font-size: 1.6rem; }
  .body :global(h3) { margin-top: 2em; font-size: 1.25rem; }
  .body :global(blockquote) {
    border-left: 3px solid var(--ink);
    padding: 0.4rem 1.5rem;
    margin: 2rem 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--ink-soft);
  }
  .body :global(ul), .body :global(ol) { padding-left: 1.4em; }
  .body :global(li) { margin-bottom: 0.5em; }
  .sources { margin-top: 3rem; padding: 1.6rem 0; border-top: 1px solid var(--border); }
  .sources h3 {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--stone);
    font-family: var(--sans);
    font-weight: 600;
  }
  .sources ul { list-style: none; padding: 0; margin: 0; }
  .sources li { font-size: 0.95rem; margin-bottom: 0.3rem; color: var(--ink-soft); }
  .closer { margin-top: 3rem; }
  .closer .kicker { font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--stone); text-align: center; }
</style>
