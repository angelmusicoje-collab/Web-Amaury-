---
import BaseLayout from '../layouts/BaseLayout.astro';

const photos = [
  { src: '/images/galeria/01.jpg', caption: 'Fachada antigua bajo la luz lateral de la tarde.' },
  { src: '/images/galeria/02.jpg', caption: 'Portal del centro con personas caminando bajo la sombra.' },
  { src: '/images/galeria/03.jpg', caption: 'Detalle: ventana, puerta o balcon con ornamento tradicional.' },
  { src: '/images/galeria/04.jpg', caption: 'Perspectiva de calle con arquitectura colonial en ambos costados.' },
  { src: '/images/galeria/05.jpg', caption: 'Plaza publica: arboles, bancas y movimiento cotidiano.' },
  { src: '/images/galeria/06.jpg', caption: 'Contraste entre comercio contemporaneo y construccion historica.' },
  { src: '/images/galeria/07.jpg', caption: 'Detalle urbano: letrero, textura de pared, farol, pavimento.' },
  { src: '/images/galeria/08.jpg', caption: 'Toma abierta del centro en ambiente de tarde colimense.' },
];
---
<BaseLayout title="Fotogaleria — Centro historico de Colima — Meridiano 104">
  <section class="head container container-text">
    <p class="kicker">Fotogaleria</p>
    <h1>Centro historico de Colima: arquitectura y vida</h1>
    <p class="dek">
      El centro historico de Colima no grita: respira. Esta galeria recorre fragmentos urbanos
      donde la arquitectura y la vida diaria se cruzan sin pedir permiso. En sus fachadas,
      portales, sombras y banquetas se guarda una parte de la memoria cotidiana del estado.
      No hacen falta eventos ni efemerides para encontrar material: la ciudad esta ahi, disponible
      y viva, todos los dias.
    </p>
  </section>

  <section class="container gallery">
    {photos.map((p, i) => (
      <figure class:list={['photo', i % 3 === 0 ? 'wide' : '']}>
        <div class="frame" style={`background-image:url(${p.src})`}>
          <div class="placeholder">
            <span class="ph-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="ph-label">Foto pendiente</span>
          </div>
        </div>
        <figcaption>{p.caption}</figcaption>
      </figure>
    ))}
  </section>
</BaseLayout>

<style>
  .head { padding: 3rem 0 2rem; }
  .kicker { font-family: var(--sans); font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--lava); margin: 0 0 0.6rem; font-weight: 600; }
  .head h1 { font-size: clamp(2rem, 5vw, 3.2rem); margin: 0 0 1rem; }
  .head .dek { font-family: var(--serif); font-style: italic; color: var(--stone); font-size: 1.2rem; line-height: 1.5; }
  .gallery {
    padding: 2rem 0 4rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  @media (max-width: 700px) {
    .gallery { grid-template-columns: 1fr; }
  }
  .photo.wide { grid-column: span 2; }
  @media (max-width: 700px) { .photo.wide { grid-column: span 1; } }
  .frame {
    aspect-ratio: 4/3;
    background-color: var(--paper-2);
    background-size: cover;
    background-position: center;
    position: relative;
    border-radius: 2px;
    overflow: hidden;
  }
  .photo.wide .frame { aspect-ratio: 21/9; }
  .placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background:
      repeating-linear-gradient(45deg, rgba(0,0,0,0.02) 0 12px, transparent 12px 24px),
      var(--paper-2);
  }
  .ph-num {
    font-family: var(--serif);
    font-size: 2.5rem;
    color: var(--lava);
    font-weight: 800;
  }
  .ph-label {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--stone);
  }
  figcaption {
    margin-top: 0.6rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--stone);
    line-height: 1.45;
  }
  figure { margin: 0; }
</style>
