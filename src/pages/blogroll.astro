---
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = [
  {
    group: 'Colima',
    items: [
      { name: 'AFmedios', desc: 'Actualidad politica, social y de seguridad en Colima.', url: 'https://afmedios.com' },
      { name: 'Diario de Colima', desc: 'El referente local de mayor trayectoria; util para seguimiento institucional y cobertura oficial.', url: 'https://diariodecolima.com' },
      { name: 'El Comentario — UdeC', desc: 'Periodismo universitario: educacion, cultura, academia y agenda publica local.', url: 'https://elcomentario.ucol.mx' },
      { name: 'Colima Noticias', desc: 'Cobertura frecuente de hechos politicos, sociales y municipales en el estado.', url: 'https://colimanoticias.com' },
    ],
  },
  {
    group: 'Nacional',
    items: [
      { name: 'Animal Politico', desc: 'Periodismo de datos, investigacion y verificacion en temas de interes publico nacional.', url: 'https://animalpolitico.com' },
      { name: 'SinEmbargo', desc: 'Politica nacional, analisis de coyuntura y opinion critica.', url: 'https://sinembargo.mx' },
      { name: 'Aristegui Noticias', desc: 'Entrevistas, investigacion periodistica y agenda publica desde el centro del pais.', url: 'https://aristeguinoticias.com' },
    ],
  },
];
---
<BaseLayout title="Blogroll — Meridiano 104">
  <section class="head container container-text">
    <p class="kicker">Blogroll</p>
    <h1>Referencias editoriales</h1>
    <p class="dek">
      Siete medios seleccionados con criterio: cuatro locales, tres nacionales. La lista no
      pretende ser exhaustiva sino util. Son sitios que consultamos, contrastamos y recomendamos
      como punto de partida para entender el dia a dia desde Colima y desde Mexico.
    </p>
  </section>

  <section class="container container-text">
    {entries.map((g) => (
      <div class="group">
        <h2>{g.group}</h2>
        <ul>
          {g.items.map((item) => (
            <li>
              <a href={item.url} rel="noopener nofollow" target="_blank">
                <span class="name">{item.name}</span>
                <span class="arrow">↗</span>
              </a>
              <p>{item.desc}</p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .head { padding: 3rem 0 2rem; }
  .kicker { font-family: var(--sans); font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--lava); margin: 0 0 0.6rem; font-weight: 600; }
  .head h1 { font-size: clamp(2rem, 5vw, 3.2rem); margin: 0 0 1rem; }
  .head .dek { font-family: var(--serif); font-style: italic; color: var(--stone); font-size: 1.2rem; line-height: 1.5; }
  .group { padding: 2rem 0 1rem; border-top: 1px solid var(--border); }
  .group h2 {
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lava);
    margin: 0 0 1.5rem;
    font-family: var(--sans);
    font-weight: 600;
  }
  ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.5rem; }
  li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    font-family: var(--serif);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--ink);
  }
  li a:hover { color: var(--lava); }
  .name { flex: 1; }
  .arrow { color: var(--stone-soft); font-weight: 400; }
  li p { margin: 0.3rem 0 0; color: var(--ink-soft); font-size: 1rem; line-height: 1.5; }
</style>
