---
import Logo from './Logo.astro';

const nav = [
  { href: '/seccion/local', label: 'Local' },
  { href: '/seccion/politica-economia', label: 'Politica' },
  { href: '/seccion/sociedad', label: 'Sociedad' },
  { href: '/seccion/ciencia-tecnologia', label: 'Ciencia' },
  { href: '/seccion/cultura', label: 'Cultura' },
  { href: '/seccion/deporte', label: 'Deporte' },
  { href: '/seccion/opinion', label: 'Opinion' },
  { href: '/seccion/medios-redes', label: 'Medios' },
  { href: '/fotogaleria', label: 'Fotogaleria' },
  { href: '/blogroll', label: 'Blogroll' },
];
---

<header class="site-header">
  <div class="container head">
    <div class="brand"><Logo /></div>
    <div class="ref">104&deg;O &middot; Colima</div>
  </div>
  <nav class="primary-nav">
    <div class="container">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(180%) blur(8px);
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.2rem;
    padding-bottom: 0.8rem;
  }
  .ref {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--stone);
    font-weight: 500;
  }
  .primary-nav {
    border-top: 1px solid var(--border);
    overflow-x: auto;
  }
  .primary-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.6rem;
    align-items: center;
    height: 44px;
    white-space: nowrap;
  }
  .primary-nav a {
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-soft);
    letter-spacing: 0.02em;
  }
  .primary-nav a:hover { color: var(--lava); }
  @media (max-width: 600px) {
    .ref { display: none; }
  }
</style>
